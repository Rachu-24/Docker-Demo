pipeline{
    agent any 
    stages{
        stage("git clone"){
            steps{
                echo "Cloning repo"
                
                
                }
            }

        stage("building docker img"){
            steps{
                echo "Building Docker img"
                sh "docker build -t python:latest ."
                }
            }
        
        stage("pushing docker img"){
            steps{
                echo"pushing docker img to docker hub"
            }
        }

        }  
}