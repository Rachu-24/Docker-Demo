pipeline{
    agent any 

    environment{
        IMAGE_NAME = "Rachu-24/python"
        TAG_NAME = "latest"

    }

    stages{
        stage("git clone"){
            steps{
                echo "Cloning repo"
                }
            }

        stage("building docker img"){
            steps{
                echo "Building Docker img"
                sh "docker build -t $IMAGE_NAME:$TAG_NAME ."
                }
            }
        stage("Running docker img"){
            steps{
                echo"Running build docker img"
                /*sh "docker run -d python:latest"*/

                sh"docker images"
            }
        }
        stage("removing docker img"){
            steps{
                echo"removed docker img"
                sh "docker rmi $IMAGE_NAME:$TAG_NAME"

                sh"docker images"
            }
        }

        }  
}